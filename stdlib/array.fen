// std/array - helpers for arrays of i32, f64 and String.
//
//     import "std/array";
//
// Fenneth has no generics, so every function exists once per element type,
// with the type as a suffix: array_sort_i32, array_sort_f64, array_sort_str.
// (Appending, removing and measuring are built in: push, pop, len.)
//
// Arrays are shared, not copied, when you assign them. Functions that say
// "in place" change the array you pass; the others return a new array.
// Strings are ordered byte by byte (see string_compare in std/string).
//
// Generated by scripts/gen-stdlib-array.py - edit the script, not this file.

import "std/string";

// ---- i32 only ----------------------------------------------------------------

// The numbers start, start+1, ..., end-1. Empty when end <= start.
fn array_range(start: i32, end: i32) -> [i32] {
    let out: [i32] = [];
    for i in start..end { push(out, i); }
    return out;
}

// ---- [i32] ---------------------------------------------------------

// A new array with the same elements.
fn array_copy_i32(a: [i32]) -> [i32] {
    let out: [i32] = [];
    for x in a { push(out, x); }
    return out;
}

// A new array with n copies of v. Panics when n < 0.
fn array_fill_i32(n: i32, v: i32) -> [i32] {
    if n < 0 { panic("array_fill_i32: negative length"); }
    let out: [i32] = [];
    for i in 0..n { push(out, v); }
    return out;
}

// The elements from index `from` up to, not including, `to`. Panics when the
// range is not inside the array.
fn array_slice_i32(a: [i32], from: i32, to: i32) -> [i32] {
    if from < 0 || to < from || to > len(a) { panic("array_slice_i32: range out of bounds"); }
    let out: [i32] = [];
    for i in from..to { push(out, a[i]); }
    return out;
}

// A new array holding the elements of a followed by those of b.
fn array_concat_i32(a: [i32], b: [i32]) -> [i32] {
    let out: [i32] = array_copy_i32(a);
    for x in b { push(out, x); }
    return out;
}

fn array_contains_i32(a: [i32], v: i32) -> bool {
    for x in a {
        if x == v { return true; }
    }
    return false;
}

// Index of the first element equal to v, or -1.
fn array_index_of_i32(a: [i32], v: i32) -> i32 {
    for i in 0..len(a) {
        if a[i] == v { return i; }
    }
    return -1;
}

// Smallest / largest element. Panic on an empty array.
fn array_min_i32(a: [i32]) -> i32 {
    if len(a) == 0 { panic("array_min_i32: empty array"); }
    let best: i32 = a[0];
    for x in a {
        if x < best { best = x; }
    }
    return best;
}

fn array_max_i32(a: [i32]) -> i32 {
    if len(a) == 0 { panic("array_max_i32: empty array"); }
    let best: i32 = a[0];
    for x in a {
        if best < x { best = x; }
    }
    return best;
}

// Reverses the array in place.
fn array_reverse_i32(a: [i32]) {
    let i: i32 = 0;
    let j: i32 = len(a) - 1;
    while i < j {
        let held: i32 = a[i];
        a[i] = a[j];
        a[j] = held;
        i += 1;
        j -= 1;
    }
}

// True when no element is smaller than the one before it.
fn array_is_sorted_i32(a: [i32]) -> bool {
    for i in 1..len(a) {
        if a[i] < a[i - 1] { return false; }
    }
    return true;
}

// Sorts a[lo..hi] with a merge sort; `tmp` is scratch space of the same size.
fn _array_msort_i32(a: [i32], tmp: [i32], lo: i32, hi: i32) {
    if hi - lo < 2 { return; }
    let mid: i32 = lo + (hi - lo) / 2;
    _array_msort_i32(a, tmp, lo, mid);
    _array_msort_i32(a, tmp, mid, hi);
    let i: i32 = lo;
    let j: i32 = mid;
    let k: i32 = lo;
    while i < mid && j < hi {
        if a[j] < a[i] {
            tmp[k] = a[j];
            j += 1;
        } else {
            tmp[k] = a[i];
            i += 1;
        }
        k += 1;
    }
    while i < mid {
        tmp[k] = a[i];
        i += 1;
        k += 1;
    }
    while j < hi {
        tmp[k] = a[j];
        j += 1;
        k += 1;
    }
    for t in lo..hi { a[t] = tmp[t]; }
}

// Sorts the array in place, smallest first. The sort is stable and takes
// O(n log n) time.
fn array_sort_i32(a: [i32]) {
    if len(a) < 2 { return; }
    _array_msort_i32(a, array_copy_i32(a), 0, len(a));
}

// The sum of all elements (0 for an empty array). Wraps on overflow.
fn array_sum_i32(a: [i32]) -> i32 {
    let total: i32 = 0;
    for x in a { total += x; }
    return total;
}

// ---- [f64] ---------------------------------------------------------

// A new array with the same elements.
fn array_copy_f64(a: [f64]) -> [f64] {
    let out: [f64] = [];
    for x in a { push(out, x); }
    return out;
}

// A new array with n copies of v. Panics when n < 0.
fn array_fill_f64(n: i32, v: f64) -> [f64] {
    if n < 0 { panic("array_fill_f64: negative length"); }
    let out: [f64] = [];
    for i in 0..n { push(out, v); }
    return out;
}

// The elements from index `from` up to, not including, `to`. Panics when the
// range is not inside the array.
fn array_slice_f64(a: [f64], from: i32, to: i32) -> [f64] {
    if from < 0 || to < from || to > len(a) { panic("array_slice_f64: range out of bounds"); }
    let out: [f64] = [];
    for i in from..to { push(out, a[i]); }
    return out;
}

// A new array holding the elements of a followed by those of b.
fn array_concat_f64(a: [f64], b: [f64]) -> [f64] {
    let out: [f64] = array_copy_f64(a);
    for x in b { push(out, x); }
    return out;
}

fn array_contains_f64(a: [f64], v: f64) -> bool {
    for x in a {
        if x == v { return true; }
    }
    return false;
}

// Index of the first element equal to v, or -1.
fn array_index_of_f64(a: [f64], v: f64) -> i32 {
    for i in 0..len(a) {
        if a[i] == v { return i; }
    }
    return -1;
}

// Smallest / largest element. Panic on an empty array.
fn array_min_f64(a: [f64]) -> f64 {
    if len(a) == 0 { panic("array_min_f64: empty array"); }
    let best: f64 = a[0];
    for x in a {
        if x < best { best = x; }
    }
    return best;
}

fn array_max_f64(a: [f64]) -> f64 {
    if len(a) == 0 { panic("array_max_f64: empty array"); }
    let best: f64 = a[0];
    for x in a {
        if best < x { best = x; }
    }
    return best;
}

// Reverses the array in place.
fn array_reverse_f64(a: [f64]) {
    let i: i32 = 0;
    let j: i32 = len(a) - 1;
    while i < j {
        let held: f64 = a[i];
        a[i] = a[j];
        a[j] = held;
        i += 1;
        j -= 1;
    }
}

// True when no element is smaller than the one before it.
fn array_is_sorted_f64(a: [f64]) -> bool {
    for i in 1..len(a) {
        if a[i] < a[i - 1] { return false; }
    }
    return true;
}

// Sorts a[lo..hi] with a merge sort; `tmp` is scratch space of the same size.
fn _array_msort_f64(a: [f64], tmp: [f64], lo: i32, hi: i32) {
    if hi - lo < 2 { return; }
    let mid: i32 = lo + (hi - lo) / 2;
    _array_msort_f64(a, tmp, lo, mid);
    _array_msort_f64(a, tmp, mid, hi);
    let i: i32 = lo;
    let j: i32 = mid;
    let k: i32 = lo;
    while i < mid && j < hi {
        if a[j] < a[i] {
            tmp[k] = a[j];
            j += 1;
        } else {
            tmp[k] = a[i];
            i += 1;
        }
        k += 1;
    }
    while i < mid {
        tmp[k] = a[i];
        i += 1;
        k += 1;
    }
    while j < hi {
        tmp[k] = a[j];
        j += 1;
        k += 1;
    }
    for t in lo..hi { a[t] = tmp[t]; }
}

// Sorts the array in place, smallest first. The sort is stable and takes
// O(n log n) time.
fn array_sort_f64(a: [f64]) {
    if len(a) < 2 { return; }
    _array_msort_f64(a, array_copy_f64(a), 0, len(a));
}

// The sum of all elements (0 for an empty array).
fn array_sum_f64(a: [f64]) -> f64 {
    let total: f64 = 0.0;
    for x in a { total += x; }
    return total;
}

// ---- [String] ------------------------------------------------------

// A new array with the same elements.
fn array_copy_str(a: [String]) -> [String] {
    let out: [String] = [];
    for x in a { push(out, x); }
    return out;
}

// A new array with n copies of v. Panics when n < 0.
fn array_fill_str(n: i32, v: String) -> [String] {
    if n < 0 { panic("array_fill_str: negative length"); }
    let out: [String] = [];
    for i in 0..n { push(out, v); }
    return out;
}

// The elements from index `from` up to, not including, `to`. Panics when the
// range is not inside the array.
fn array_slice_str(a: [String], from: i32, to: i32) -> [String] {
    if from < 0 || to < from || to > len(a) { panic("array_slice_str: range out of bounds"); }
    let out: [String] = [];
    for i in from..to { push(out, a[i]); }
    return out;
}

// A new array holding the elements of a followed by those of b.
fn array_concat_str(a: [String], b: [String]) -> [String] {
    let out: [String] = array_copy_str(a);
    for x in b { push(out, x); }
    return out;
}

fn array_contains_str(a: [String], v: String) -> bool {
    for x in a {
        if x == v { return true; }
    }
    return false;
}

// Index of the first element equal to v, or -1.
fn array_index_of_str(a: [String], v: String) -> i32 {
    for i in 0..len(a) {
        if a[i] == v { return i; }
    }
    return -1;
}

// Smallest / largest element. Panic on an empty array.
fn array_min_str(a: [String]) -> String {
    if len(a) == 0 { panic("array_min_str: empty array"); }
    let best: String = a[0];
    for x in a {
        if string_compare(x, best) < 0 { best = x; }
    }
    return best;
}

fn array_max_str(a: [String]) -> String {
    if len(a) == 0 { panic("array_max_str: empty array"); }
    let best: String = a[0];
    for x in a {
        if string_compare(best, x) < 0 { best = x; }
    }
    return best;
}

// Reverses the array in place.
fn array_reverse_str(a: [String]) {
    let i: i32 = 0;
    let j: i32 = len(a) - 1;
    while i < j {
        let held: String = a[i];
        a[i] = a[j];
        a[j] = held;
        i += 1;
        j -= 1;
    }
}

// True when no element is smaller than the one before it.
fn array_is_sorted_str(a: [String]) -> bool {
    for i in 1..len(a) {
        if string_compare(a[i], a[i - 1]) < 0 { return false; }
    }
    return true;
}

// Sorts a[lo..hi] with a merge sort; `tmp` is scratch space of the same size.
fn _array_msort_str(a: [String], tmp: [String], lo: i32, hi: i32) {
    if hi - lo < 2 { return; }
    let mid: i32 = lo + (hi - lo) / 2;
    _array_msort_str(a, tmp, lo, mid);
    _array_msort_str(a, tmp, mid, hi);
    let i: i32 = lo;
    let j: i32 = mid;
    let k: i32 = lo;
    while i < mid && j < hi {
        if string_compare(a[j], a[i]) < 0 {
            tmp[k] = a[j];
            j += 1;
        } else {
            tmp[k] = a[i];
            i += 1;
        }
        k += 1;
    }
    while i < mid {
        tmp[k] = a[i];
        i += 1;
        k += 1;
    }
    while j < hi {
        tmp[k] = a[j];
        j += 1;
        k += 1;
    }
    for t in lo..hi { a[t] = tmp[t]; }
}

// Sorts the array in place, smallest first. The sort is stable and takes
// O(n log n) time.
fn array_sort_str(a: [String]) {
    if len(a) < 2 { return; }
    _array_msort_str(a, array_copy_str(a), 0, len(a));
}
