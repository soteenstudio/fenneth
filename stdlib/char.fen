// std/char - classifying and converting bytes.
//
//     import "std/char";
//
// A "char" here is a byte value as returned by str_at() (0..255). Only ASCII
// letters, digits and whitespace are classified; every other byte is none of
// them. Use char_str() to turn a byte back into a String.

fn char_is_digit(c: i32) -> bool { return c >= 48 && c <= 57; }
fn char_is_upper(c: i32) -> bool { return c >= 65 && c <= 90; }
fn char_is_lower(c: i32) -> bool { return c >= 97 && c <= 122; }

fn char_is_alpha(c: i32) -> bool {
    return char_is_upper(c) || char_is_lower(c);
}

fn char_is_alnum(c: i32) -> bool {
    return char_is_alpha(c) || char_is_digit(c);
}

// Space, tab, newline, carriage return, vertical tab and form feed.
fn char_is_space(c: i32) -> bool {
    return c == 32 || (c >= 9 && c <= 13);
}

fn char_to_upper(c: i32) -> i32 {
    if char_is_lower(c) { return c - 32; }
    return c;
}

fn char_to_lower(c: i32) -> i32 {
    if char_is_upper(c) { return c + 32; }
    return c;
}

// Value of a digit byte: '0'..'9' -> 0..9, 'a'..'z'/'A'..'Z' -> 10..35.
// Gives -1 for any other byte.
fn char_digit_value(c: i32) -> i32 {
    if char_is_digit(c) { return c - 48; }
    if char_is_lower(c) { return c - 97 + 10; }
    if char_is_upper(c) { return c - 65 + 10; }
    return -1;
}
