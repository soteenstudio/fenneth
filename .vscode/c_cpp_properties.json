{
  "version": 4,
  "configurations": [
    {
      "name": "Fenneth runtime (MinGW-w64 / w64devkit)",
      "compilerPath": "C:/w64devkit/w64devkit/bin/gcc.exe",
      "cStandard": "c99",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/runtime",
        "C:/w64devkit/w64devkit/include",
        "C:/w64devkit/w64devkit/x86_64-w64-mingw32/include"
      ],
      "forcedInclude": ["${workspaceFolder}/src/runtime.c"],
      "defines": ["_WIN32", "__MINGW64__"],
      "browse": {
        "path": ["${workspaceFolder}/src", "C:/w64devkit/w64devkit/include"],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Fenneth runtime (MSYS2 / Cygwin)",
      "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
      "cStandard": "c99",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/runtime",
        "C:/msys64/ucrt64/include",
        "C:/msys64/usr/include"
      ],
      "forcedInclude": ["${workspaceFolder}/src/runtime.c"],
      "defines": ["_WIN32"]
    },
    {
      "name": "Fenneth runtime (Linux / macOS)",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c99",
      "intelliSenseMode": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/runtime",
        "/usr/include",
        "/usr/local/include"
      ],
      "forcedInclude": ["${workspaceFolder}/src/runtime.c"]
    }
  ]
}
